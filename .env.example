# Frontend settings. All optional. Copy to .env.local to override on your PC.

# Where `npm run dev` forwards /api. Default: http://localhost:3001 (your local backend).
# VITE_PROXY_TARGET=https://smart-navigation-be.onrender.com

# Leave empty (recommended): the browser calls /api on its own site, and Vercel's
# rewrite in vercel.json forwards it to Render. Set it only to call a backend directly,
# e.g. https://smart-navigation-be.onrender.com (then set CORS_ORIGIN on the backend).
# VITE_API_URL=
